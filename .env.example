# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CONTACT & NOTIFICATIONS CONFIGURATION
CONTACT_TO_EMAIL="shubhamvaishnav640@gmail.com"

# OPTIONAL PERSISTENCE (Graceful degradation active if omitted)
MONGODB_URI=""

# OPTIONAL TRANSACTIONAL SMTP (Console dev fallback active if omitted)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="portfolio@shubhamvaishnav.dev"
SMTP_SECURE="false"
